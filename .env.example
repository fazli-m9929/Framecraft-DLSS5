# Copy this file to .env, then edit. Paths can be absolute.
NVS_HOST=127.0.0.1
NVS_PORT=7860
NVS_RUNTIME_DIR=runtime
NVS_PREVIEW_DIR=preview
NVS_DATA_DIR=data
# NVS_FFMPEG=C:/Tools/ffmpeg/bin/ffmpeg.exe
# NVS_FFPROBE=C:/Tools/ffmpeg/bin/ffprobe.exe
NVS_MAX_UPLOAD_GB=20
# Experimental: permit an unrecognized GPU to attempt worker startup (NO guarantee of compatibility)
NVS_ALLOW_UNVERIFIED_GPU=false
